<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.procurement.mapper.PmsProcurementRequestMapper">

    <resultMap type="org.dromara.procurement.domain.vo.PmsProcurementRequestVo" id="PmsProcurementRequestResult">
        <id property="id" column="id"/>
        <result property="requestCode" column="request_code"/>
        <result property="title" column="title"/>
        <result property="titleType" column="title_type"/>
        <result property="titleName" column="title_name"/>
        <result property="projectId" column="project_id"/>
        <result property="projectName" column="project_name"/>
        <result property="leader" column="leader"/>
        <result property="procurementContact" column="procurement_contact"/>
        <result property="paymentScreenshot" column="payment_screenshot"/>
        <result property="quotationUrl" column="quotation_url"/>
        <result property="invoiceInfoJson" column="invoice_info_json"/>
        <result property="remainingBudget" column="remaining_budget"/>
        <result property="amount" column="amount"/>
        <result property="purchaseType" column="purchase_type"/>
        <result property="applyReason" column="apply_reason"/>
        <result property="status" column="status"/>
        <result property="processInstanceId" column="process_instance_id"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectVoPageList" resultMap="PmsProcurementRequestResult">
        SELECT
            r.*,
            p.project_name,
            p.leader AS leader,
            (p.budget - COALESCE(p.used_amount, 0)) AS remaining_budget
        FROM pms_procurement_request r
        LEFT JOIN pms_project p ON r.project_id = p.id AND p.del_flag = '0'
        <where>
            AND r.del_flag = '0'
            <if test="bo.requestCode != null and bo.requestCode != ''">
                AND r.request_code LIKE CONCAT('%', #{bo.requestCode}, '%')
            </if>
            <if test="bo.title != null and bo.title != ''">
                AND r.title LIKE CONCAT('%', #{bo.title}, '%')
            </if>
            <if test="bo.projectId != null">
                AND r.project_id = #{bo.projectId}
            </if>
            <if test="bo.status != null and bo.status != ''">
                AND r.status = #{bo.status}
            </if>
            <if test="bo.purchaseType != null and bo.purchaseType != ''">
                AND r.purchase_type = #{bo.purchaseType}
            </if>
            <if test="bo.titleType != null and bo.titleType != ''">
                AND r.title_type = #{bo.titleType}
            </if>
            <if test="bo.params.beginCreateTime != null and bo.params.endCreateTime != null">
                AND r.create_time BETWEEN #{bo.params.beginCreateTime} AND #{bo.params.endCreateTime}
            </if>
        </where>
        ORDER BY r.create_time DESC
    </select>

    <select id="selectAcceptableList" resultMap="PmsProcurementRequestResult">
        SELECT
            r.*,
            p.project_name,
            p.leader AS leader,
            (p.budget - COALESCE(p.used_amount, 0)) AS remaining_budget
        FROM pms_procurement_request r
        LEFT JOIN pms_project p ON r.project_id = p.id AND p.del_flag = '0'
        WHERE r.del_flag = '0'
          AND r.status = 'finish'
          AND (r.acceptance_status IS NULL OR r.acceptance_status = 'none')
        ORDER BY r.create_time DESC
    </select>

</mapper>
