{
  // ===== Java (Language Support for Java 扩展) =====
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.maven.enabled": true,
  "java.import.maven.offlineEnabled": true,
  "java.project.importOnFirstTimeStartup": "automatic",
  "java.project.importHint": false,

  // 关闭 JDT null analysis（检测到依赖里的 JSpecify 注解后自动启用，对 MyBatis-Plus
  // 泛型 lambda 产生大量 Null type safety 误报，见 redhat-developer/vscode-java#2716）
  "java.compile.nullAnalysis.mode": "disabled",

  // ===== 文件显示 =====
  // 排除各模块的编译产物目录，避免 IDE 索引生成代码产生假报错
  "files.exclude": {
    "**/target": true
  },
  "search.exclude": {
    "**/target": true
  },
  "files.watcherExclude": {
    "**/target": true
  },

  // ===== Git 状态与问题染色分离 =====
  // 彻底关闭资源管理器里因 TypeScript/Java 等诊断产生的颜色+徽章装饰，
  // 只保留 git 本身的 M/U/D 字母徽章，让目录树清晰显示代码改动。
  // 问题本身仍可在 Ctrl+Shift+M Problems 面板查看，不影响 AI 读报错。
  "problems.decorations.enabled": false,
  "gitlens.decorations.enabled": false,
  "explorer.decorations.colors": false,
  "explorer.decorations.badges": true
}
