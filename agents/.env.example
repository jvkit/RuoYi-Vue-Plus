# ===== 服务 =====
AGENTS_HOST=127.0.0.1
AGENTS_PORT=8093

# ===== LLM 网关（LiteLLM）=====
# 文本模型端点
LLM_BASE_URL=https://chat.iphy.ac.cn/api/v1
LLM_API_KEY=sk-xxxxx
LLM_MODEL=glm-5.2

# 视觉模型端点（发票识别等图片任务），与文本模型分离，便于单独换多模态
VISION_BASE_URL=http://192.168.236.13:47501/v1
VISION_API_KEY=sk-xxxxx
VISION_MODEL=Qwen-Qwen3.5-35B-A3B-GPTQ-Int4-tool-image-4080s

# ===== 并发 / 窗口 =====
# PDF 只取第一页，超过 max_pages 页的发票标记 "多页已按首页处理"
MAX_PDF_PAGES=1
# 转图 DPI
PDF_DPI=200
# 图片长边上限
MAX_IMAGE_LONG_EDGE=1536
# 并发识别数
CONCURRENCY=3
# 单发票识别超时秒
AGENT_TIMEOUT_SECONDS=60

# ===== Langfuse =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
